{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadMnemosysParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": "arn:aws:ssm:__AWS_REGION__:__AWS_ACCOUNT_ID__:parameter/mnemosys/*"
    },
    {
      "Sid": "DecryptSsmParameters",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:__AWS_REGION__:__AWS_ACCOUNT_ID__:alias/aws/ssm"
    }
  ]
}
